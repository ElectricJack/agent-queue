.envrc
.worktrees/
__pycache__/
*.egg-info/
.venv/
*.pyc
.claude
*.db
*.db-shm
*.db-wal
spin_utility.log

# LLM interaction logs
logs/

# Documentation build output
site/
docs_out/
eval_results
.agent-queue-lock
archived_tasks/
.claude
plan.md
.claude

# Frontend
node_modules/
dashboard/dist/
# Staged by `aq install` (dashboard.build) or scripts/build_release_artifact.py.
src/dashboard_assets/dist/
src/dashboard_assets/.aq-dashboard-source
dashboard/.vite/
*.tsbuildinfo
packages/aq-ts-client/src/
!packages/aq-ts-client/src/index.ts
docs/.obsidian

# Outrider
.outrider/

# Deployment secrets: deploy/.env holds the database DSN and harness
# credentials. Only the .example is committed.
deploy/.env
deploy/*.env
!deploy/.env.example

# Per-workspace agent state: hook settings, worktree slots, sentinels.
# Generated per checkout by the session runtime — never shared.
/.aq/

# Coverage output (pytest-cov / coverage.py). The `.coverage.<host>.<pid>.*`
# form is what `-n auto` leaves behind, one per xdist worker.
.coverage
.coverage.*
coverage.json
htmlcov/
# TypeScript incremental build metadata
*.tsbuildinfo

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Terraform. State is NOT safe to commit: it contains the generated database
# password in plaintext. The provider lock file is committed on purpose.
deploy/terraform/**/.terraform/
deploy/terraform/**/*.tfstate
deploy/terraform/**/*.tfstate.*
deploy/terraform/**/*.tfplan
deploy/terraform/**/terraform.tfvars
deploy/terraform/**/*.auto.tfvars
!deploy/terraform/**/terraform.tfvars.example

# Credential files and generated config overlays mounted into the daemon.
# Only the .gitkeep markers are tracked.
deploy/secrets/*
!deploy/secrets/.gitkeep
deploy/profiles/*
!deploy/profiles/.gitkeep
