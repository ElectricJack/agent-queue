it","transitions":{"rejected":"route-task--failed","routed":"route-task--done","runtime_error":"route-task--failed"},"type":"command"},"route-task--choose":{"budget":{"max_calls":1,"max_output_tokens":4096,"max_total_tokens":4096,"timeout_seconds":300},"inputs":{"description":{"binding":"routing","path":"description","type":"binding_ref"},"options":{"binding":"routing","path":"options","type":"binding_ref"},"priority":{"binding":"routing","path":"priority","type":"binding_ref"},"task_type":{"binding":"routing","path":"task_type","type":"binding_ref"},"title":{"binding":"routing","path":"title","type":"binding_ref"}},"output_schema":{"additionalProperties":false,"properties":{"intelligence_class":{"type":"string"},"profile_id":{"type":"string"},"reason":{"maxLength":400,"minLength":1,"type":"string"}},"required":["intelligence_class","reason","profile_id"],"type":"object"},"profile_id":"playbook-compiler","prompt":{"type":"literal","value":"## Choosing a class\n\nDefault to `standard-high` for ordinary feature implementation, debugging,\nrefactoring, tests, and coordinated changes across modules. Most development\ntasks belong in this class. Use a fast class only for clearly trivial, localized\nwork whose requirements are already settled.\n\nUse `deep-high` only for exceptionally difficult work: a genuinely unresolved\narchitectural problem, a hard investigation with concrete evidence that standard\nreasoning was insufficient, or unusually complex correctness reasoning. The\nreason must name that specific difficulty and explain why `standard-high` is\ninsufficient. C++, multiple files, native builds, integration tests, high priority,\nand a failing CI run alone are not reasons to select `deep-high`.\n\nChoose a class and compatible profile only from the supplied options. Preserve\nexplicit operator assignments. If `standard-high` is absent, select the closest\nsuitable available standard class and explain the fallback; do not promote to\ndeep just because workers are temporarily occupied.\n\nGive a concise, non-empty reason describing difficulty. Return exactly:\n\n```json\n{\"intelligence_class\":\"<class from options>\",\"profile_id\":\"<profile from the same options row>\",\"reason\":\"<why this difficulty fits>\"}\n```"},"rule":"route-task","save_result_as":"decision","source":{"end_line":22,"excerpt":"## Rule: route-task","path":"default-assignment-routing.md","start_line":22},"title":"choose","tool_use":{"aq_commands":[],"enabled":false,"plugin_tools":[]},"transitions":{"completed":"route-task--apply_decision","runtime_error":"route-task--failed"},"type":"llm"},"route-task--done":{"outcome":"completed","rule":"route-task","source":{"end_line":22,"excerpt":"## Rule: route-task","path":"default-assignment-routing.md","start_line":22},"title":"Completed","type":"terminal"},"route-task--failed":{"outcome":"failed","rule":"route-task","source":{"end_line":22,"excerpt":"## Rule: route-task","path":"default-assignment-routing.md","start_line":22},"title":"Failed","type":"terminal"},"route-task--read_options":{"command":"task_route_options","inputs":{"task_id":{"path":"task_id","type":"event_ref"}},"rule":"route-task","save_result_as":"routing","source":{"end_line":22,"excerpt":"## Rule: route-task","path":"default-assignment-routing.md","start_line":22},"title":"read_options","transitions":{"already_routed":"route-task--done","explicit":"route-task--apply_explicit","no_options":"route-task--failed","rejected":"route-task--failed","runtime_error":"route-task--failed","undecided":"route-task--choose"},"type":"command"}},"version":3}