 supervisor and do not commit affected work. Delegated or general approval alone does not authorize dropping a goal. Implementation specs get parallel phase epics and self-contained children. Validate, then task_batch_propose followed directly by task_batch_commit; no human proposal gate. The batch creates work only; updates to existing tasks need an approved change set."}],"type":"template"},"intelligence_class":{"type":"literal","value":"deep-high"},"profile_id":{"type":"literal","value":"spec-ingest"},"project_id":{"path":"project_id","type":"event_ref"},"title":{"parts":[{"type":"literal","value":"Ingest spec "},{"path":"spec_path","type":"event_ref"}],"type":"template"}},"rule":"spec-ingest-on-approve","source":{"end_line":31,"excerpt":"1. Call `ensure_task` in the event's `project_id` with `dedup_key`","heading":"Rule: spec-ingest-on-approve","path":"default-pipeline.md","start_line":31},"title":"spec_ingest_gate","transitions":{"created":"spec-ingest-on-approve--done","rejected":"spec-ingest-on-approve--failed","reused":"spec-ingest-on-approve--done","runtime_error":"spec-ingest-on-approve--failed"},"type":"command"}},"version":1}