{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    // The playbook-graph test fixtures import the backend's golden explanation
    // payloads from tests/fixtures/contracts/ so the two suites assert the same
    // rendered copy.  Vite/Vitest resolve JSON natively; tsc needs telling.
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"]
}
