ch on the verdict line","type":"decision"},"pre-market--alert":{"command":"message_send","inputs":{"body":{"parts":[{"type":"literal","value":"The 03:00 pre-market health check found a problem that needs attention before NYSE opens at 06:30 PT. Live deployments trade real money."},{"type":"literal","value":"\n\n"},{"options":[{"binding":"premarket_report","path":"completion.summary","type":"binding_ref"},{"type":"literal","value":""}],"type":"coalesce"},{"type":"literal","value":"\n\nCheck task: "},{"binding":"premarket_check","path":"task_id","type":"binding_ref"},{"type":"literal","value":"\nPlaybook run: "},{"options":[{"path":"run_id","type":"context_ref"},{"type":"literal","value":"(no run id)"}],"type":"coalesce"}],"type":"template"},"from_id":{"type":"literal","value":"playbook:quilt-health-watch"},"from_kind":{"type":"literal","value":"system"},"priority":{"type":"literal","value":10},"project_id":{"type":"literal","value":"quilt-trader"},"subject":{"type":"literal","value":"Quilt Trader PRE-MARKET ALERT: fix before the 06:30 PT open"},"to_id":{"type":"literal","value":"dashboard"},"to_kind":{"type":"literal","value":"user"}},"rule":"pre-market","source":{"end_line":127,"excerpt":"4. Call `message_send` with `project_id` `quilt-trader`, `to_kind` `user`,","heading":"Rule: pre-market","path":"projects/quilt-trader/playbooks/quilt-health-watch.md","start_line":127},"title":"Alert Jack","transitions":{"contract_violation":"pre-market--failed","input_resolution_failed":"pre-market--failed","queued":"pre-market--done","rejected":"pre-market--failed","runtime_error":"pre-market--failed","state_limit_exceeded":"pre-market--failed"},"type":"command"},"pre-market--all-clear":{"command":"message_send","inputs":{"body":{"parts":[{"type":"literal","value":"Every condition the health check alerted on has cleared.\n\n"},{"options":[{"binding":"premarket_report","path":"completion.summary","type":"binding_ref"},{"type":"literal","value":""}],"type":"coalesce"},{"type":"literal","value":"\n\nCheck task: "},{"binding":"premarket_check","path":"task_id","type":"binding_ref"},{"type":"literal","value":"\nPlaybook run: "},{"options":[{"path":"run_id","type":"context_ref"},{"type":"literal","value":"(no run id)"}],"type":"coalesce"}],"type":"template"},"from_id":{"type":"literal","value":"playbook:quilt-health-watch"},"from_kind":{"type":"literal","value":"system"},"priority":{"type":"literal","value":50},"project_id":{"type":"literal","value":"quilt-trader"},"subject":{"type":"literal","value":"Quilt Trader recovered"},"to_id":{"type":"literal","value":"dashboard"},"to_kind":{"type":"literal","value":"user"}},"rule":"pre-market","source":{"end_line":134,"excerpt":"5. Call `message_send` as in step 4 with `priority` 50, `subject` \"Quilt","heading":"Rule: pre-market","path":"projects/quilt-trader/playbooks/quilt-health-watch.md","start_line":134},"title":"Tell Jack it recovered","transitions":{"contract_violation":"pre-market--failed","input_resolution_failed":"pre-market--failed","queued":"pre-market--done","rejected":"pre-market--failed","runtime_error":"pre-market--failed","state_limit_exceeded":"pre-market--failed"},"type":"command"},"pre-market--check":{"cancel_child":false,"capability_narrowing":{"harness_tools":["Bash","Read","Grep","Glob"]},"inputs":{"description":{"parts":[{"type":"literal","value":"Mode: pre-market (03:00, before the 06:30 open)\nTick: "},{"path":"tick_time","type":"event_ref"},{"type":"literal","value":" (UTC)\n\n"},{"type":"literal","value":"You are the Quilt Trader health check. Read-only: never place or cancel orders;\nnever create, change, stop, start or restart deployments; never change algorithm\nconfig, accounts or coordinator settings; never run `quilt up` or `quilt down`\nyourself; never edit, commit or push anything. The only repair allowed is the\nsingle watchdog run that `health_watch.py check` performs by itself. Do not\nmessage anyone: the playbook reads your close summary and sends any alert.\n\n1. From your quilt-trader workspace run:\n     python3 scripts/health_watch.py check | tee .aq/health-watch.json\n   It can take about four minutes when the coordinator is down. If the command\n   fails or prints no JSON, skip to step 4 and close with the summary\n   \"QUILT-HEALTH: ALERT - health_watch.py failed: <last error line>\".\n2. For each entry of errors.to_file (the script offers at most 5; later checks\n   offer the rest), run its file_command exactly as printed. It files one\n   bugfix task at the project root, reading the title and the log excerpt from\n   files the script wrote. Note the task id it prints.\n3. Record what you did:\n     python3 scripts/health_watch.py commit --scan <scan_id> \\\n       --filed <id>=<task id> [--filed ... for each task you filed]\n4. Close. The summary's first line must be verdict_line exactly as printed;\n   add one line per bugfix task you filed (\"filed <task id>: <signature>\"):\n     aq task close --outcome pass --work-outcome no-op --summary \"<verdict_line>\n     <filed lines>\"\n"}],"type":"template"},"parent_key":{"type":"literal","value":"quilt-health-checks"},"parent_title":{"type":"literal","value":"Quilt Trader health checks"},"priority":{"type":"literal","value":20},"project_id":{"type":"literal","value":"quilt-trader"},"title":{"parts":[{"type":"literal","value":"Quilt health check (pre-market (03:00, before the 06:30 open)) at "},{"path":"tick_time","type":"event_ref"}],"type":"template"}},"intelligence_class":"fast-low","objective":{"parts":[{"type":"literal","value":"Quilt Trader health check, "},{"type":"literal","value":"pre-market (03:00, before the 06:30 open)"}],"type":"template"},"rule":"pre-market","save_result_as":"premarket_check","source":{"end_line":115,"excerpt":"1. Start the check task described above with mode \"pre-market (03:00, before","heading":"Rule: pre-market","path":"projects/quilt-trader/playbooks/quilt-health-watch.md","start_line":115},"timeout_seconds":2400,"title":"Run the hea