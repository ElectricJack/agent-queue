              "type": "string"
            },
            "parent_id": {
              "type": "string"
            },
            "root": {
              "type": "boolean",
              "default": false
            },
            "expected_old_generation": {
              "type": "integer",
              "description": "Hierarchical projects: the old parent's integration generation."
            },
            "expected_new_generation": {
              "type": "integer",
              "description": "Hierarchical projects: the new parent's integration generation."
            }
          },
          "required": [
            "task_id"
          ]
        }
      }
    }
