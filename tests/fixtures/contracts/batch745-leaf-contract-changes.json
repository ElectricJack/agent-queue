        "project_relocate": {
          "previous": null,
          "current": {
            "name": "project_relocate",
            "description": "Preview or apply an atomic project storage relocation. Requires paused admission, disabled/drained train, stopped writers and current required CI. Reverse relocation uses a fresh destination containing current work. Local operator only.",
            "input_schema": {
              "type": "object",
              "properties": {
                "project_id": {
                  "type": "string"
                },
                "destination": {
                  "type": "string"
                },
                "owner_inventory": {
                  "type": "object"
                },
                "expected_digest": {
                  "type": "string"
                },
                "apply": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "project_id",
                "destination",
                "owner_inventory"
              ]
            }
          }
        },
        "integration_continue_close": {
          "previous": null,
          "current": {
            "name": "integration_continue_close",
            "description": "Continue the parent merge belonging to your held task and session.",
            "input_schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation_id"
              ],
              "properties": {
                "operation_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
