# Agent Queue container environment. Copy to deploy/.env and fill in.
#
#     cp .env.example .env
#
# deploy/.env is gitignored. Never commit a filled-in copy.
#
# Every ${...} referenced by deploy/config.template.yaml must be set here:
# src/config.py raises on an unset variable rather than defaulting silently.

# --- Database (required) -----------------------------------------------------
# One whole DSN. Do not split the password into a separate variable.
#
#   Managed (Cloud SQL private IP, RDS, Neon):
#     AQ_DATABASE_URL=postgresql+asyncpg://aq:PASSWORD@10.x.x.x:5432/agent_queue
#   Local `--profile local-db` postgres container:
#     AQ_DATABASE_URL=postgresql+asyncpg://agent_queue:agent_queue_dev@postgres:5432/agent_queue
#
# PostgreSQL only — SQLite is no longer supported. No server-side extensions
# are required, so a managed instance with no superuser is fine.
AQ_DATABASE_URL=

# --- Chat bot ----------------------------------------------------------------
# Not configured. config.template.yaml sets `messaging_platform: none`, which
# selects the no-op adapter. To enable Discord later, set it back to "discord",
# add a `discord:` block with `bot_token: ${AQ_DISCORD_BOT_TOKEN}`, and set:
# AQ_DISCORD_BOT_TOKEN=

# --- Harness credentials -----------------------------------------------------
# AQ never types a credential; these are the documented headless paths from
# src/install/logins.py. Supply whichever harnesses the image was built with.
#
# Claude — use ANTHROPIC_API_KEY. A Console key from console.anthropic.com.
#
# NOTE: CLAUDE_CODE_OAUTH_TOKEN (what `claude setup-token` prints) does NOT
# work when passed through the daemon environment, despite being listed in
# HARNESS_CREDENTIAL_ALLOWLIST. src/env_scrub.py's is_harness_session_marker()
# matches every CLAUDE_CODE_* name and is checked *before* the allowlist, so
# the token is dropped at daemon startup and again in scrub_env. ANTHROPIC_API_KEY
# is explicitly exempted from that rule and is the shape the installer expects
# ("it lives in the daemon env file").
ANTHROPIC_API_KEY=

# Codex — `codex login --device-auth` on another device, or an API key.
# OPENAI_API_KEY=

# Gemini — an API key, or Vertex AI. On GCP the Vertex path is the best option:
# attach a service account to the VM and no long-lived secret lives on the box.
# GEMINI_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Build/runtime options ---------------------------------------------------
# Harnesses baked into the daemon image at build time (comma-separated).
AQ_HARNESSES=claude,codex

# Host port for the dashboard, bound to 127.0.0.1 only. Defaults to 8088
# because 8080 is so often already taken.
# AQ_DASHBOARD_PORT=8088

# Password for the opt-in local postgres container (--profile local-db).
# AQ_LOCAL_DB_PASSWORD=agent_queue_dev
