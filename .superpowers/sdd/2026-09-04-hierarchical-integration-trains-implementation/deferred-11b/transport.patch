+def _pin_node(path: Path, *, kind: str, include_digest: bool = False) -> PinnedNode:
+    details = path.lstat() if kind == "symlink" else path.stat()
+    actual_kind = (
+        "symlink" if stat.S_ISLNK(details.st_mode)
+        else "directory" if stat.S_ISDIR(details.st_mode)
+        else "file" if stat.S_ISREG(details.st_mode)
+        else "other"
+    )
+    if actual_kind != kind:
+        raise TransportInspectionError("unsafe credential topology node")
+    digest = None
+    if include_digest:
+        digest = "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()
+    return PinnedNode(
+        path=str(path),
+        kind=kind,
+        device=details.st_dev,
+        inode=details.st_ino,
+        owner=details.st_uid,
+        mode=stat.S_IMODE(details.st_mode),
+        digest=digest,
+    )
