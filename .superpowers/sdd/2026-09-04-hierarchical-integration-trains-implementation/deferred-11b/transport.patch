+def _directory_facts(paths: tuple[Path, ...], *, stop: Path) -> tuple[PinnedNode, ...]:
+    stop = stop.resolve(strict=True)
+    found: dict[str, PinnedNode] = {}
+    for path in paths:
+        current = path.resolve(strict=True)
+        if not current.is_dir():
+            current = current.parent
+        while True:
+            if current != stop and stop not in current.parents:
+                raise TransportInspectionError("credential path escaped trusted root")
+            node = _pin_node(current, kind="directory")
+            found[node.path] = node
+            if current == stop:
+                break
+            current = current.parent
+    return tuple(found[key] for key in sorted(found))
