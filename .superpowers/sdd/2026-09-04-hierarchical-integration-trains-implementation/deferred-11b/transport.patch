+def collect_worker_launch_postures(
+    *,
+    profiles: tuple[object, ...],
+    projects: tuple[object, ...],
+    workspaces: tuple[object, ...],
+    harness_registry: object,
+    spec_builder: object,
+    executable_resolver=shutil.which,
+) -> tuple[WorkerLaunchPosture, ...]:
+    """Enumerate every currently routable profile/harness/workspace posture.
+
+    The real project-aware harness registry and SessionSpecBuilder argv
+    composer are authoritative. Only authority booleans and executable
+    identity survive; raw argv/environment values are discarded.
+    """
+    from src.sessions.spec import skip_permissions_allowed
+
+    variants_by_project: dict[str, set[str]] = {}
+    for workspace in workspaces:
+        project_id = str(getattr(workspace, "project_id", "") or "")
+        source = getattr(workspace, "source_type", "")
+        variant = getattr(source, "value", source)
+        if project_id and isinstance(variant, str) and variant:
+            variants_by_project.setdefault(project_id, set()).add(variant)
+    bypass_flags = frozenset(
+        {
+            "--dangerously-bypass-approvals-and-sandbox",
+            "--dangerously-skip-permissions",
+            "--full-auto",
+            "--yolo",
+        }
+    )
+    result: list[WorkerLaunchPosture] = []
+    for profile in profiles:
+        if getattr(profile, "runtime", "") not in {"", None}:
+            continue
+        profile_id = str(getattr(profile, "id", "") or "")
+        harness_id = str(getattr(profile, "harness", "") or "")
+        lifecycle = str(getattr(profile, "lifecycle", "task") or "task")
+        if not profile_id or not harness_id:
+            continue
+        for project in projects:
+            project_id = str(getattr(project, "id", "") or "")
+            harness = harness_registry.get(harness_id, project_id)
+            if harness is None:
+                continue
+            variants = (
+                {"none"}
+                if lifecycle == "named" or not getattr(profile, "needs_workspace", True)
+                else variants_by_project.get(project_id, set())
+            )
+            for variant in sorted(variants):
+                source = type("ObservedWorkspaceSource", (), {"value": variant})()
+                argv = spec_builder._compose_argv(
+                    harness=harness,
+                    profile=profile,
+                    session_id="authority-inspection",
+                    resume_key=None,
+                    prompt=None,
+                    session_name="authority-inspection",
+                    files=[],
+                    allow_skip_permissions=skip_permissions_allowed(profile, source),
+                    hook_files=[],
+                )
+                executable = executable_resolver(argv[0])
+                executable_path = str(Path(executable).resolve()) if executable else argv[0]
+                try:
+                    executable_bytes = Path(executable_path).read_bytes()
+                except OSError:
+                    executable_bytes = ("unresolved:" + executable_path).encode()
+                result.append(
+                    WorkerLaunchPosture(
+                        profile_id=profile_id,
+                        project_id=project_id,
+                        harness_id=harness.id,
+                        lifecycle=lifecycle,
+                        workspace_variant=variant,
+                        executable_path=executable_path,
+                        executable_digest="sha256:"
+                        + hashlib.sha256(executable_bytes).hexdigest(),
+                        effective_uid=os.geteuid(),
+                        bypass_capable=any(item in bypass_flags for item in argv),
+                    )
+                )
+    return tuple(
+        sorted(
+            result,
+            key=lambda item: (
+                item.profile_id,
+                item.project_id,
+                item.harness_id,
+                item.lifecycle,
+                item.workspace_variant,
+            ),
+        )
     )
 
 
