+    def observe(
+        self, posture: WorkerLaunchPosture, protected_paths: tuple[str, ...]
+    ) -> WorkerAuthorityObservation:
+        same_uid = posture.effective_uid == os.geteuid()
+        writable = same_uid and any(os.access(path, os.W_OK) for path in protected_paths)
