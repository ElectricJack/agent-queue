+def inspect_installed_transport(
+    *,
+    exec_path: Path,
+    askpass_path: Path,
+    private_key_paths: tuple[Path, ...],
+    worker_postures: tuple[WorkerLaunchPosture, ...],
+    authority_inspector: WorkerAuthorityInspector | None = None,
+    git_path: Path = Path("/usr/bin/git"),
+    interpreter_path: Path = Path("/usr/bin/python3"),
+    expected_system_owner: int = 0,
+    trusted_root: Path = Path("/"),
+) -> TransportInspectionResult:
+    """Inspect the complete installed credential transport and worker authority.
+
+    The default authority inspector deliberately describes the current
+    same-UID/unconfined launcher as unsafe. A caller may inject a verifier only
+    when it observes an actual launcher/kernel confinement policy.
+    """
+    topology = inspect_git_credential_topology(
+        exec_path=exec_path,
+        askpass_path=askpass_path,
+        git_path=git_path,
+        interpreter_path=interpreter_path,
+        expected_system_owner=expected_system_owner,
+        trusted_root=trusted_root,
+    )
+    keys: list[PinnedFile] = []
+    for path in private_key_paths:
+        try:
+            keys.append(_pin_private_key(path))
+        except OSError as exc:
+            raise TransportInspectionError("unsafe private key path") from exc
+    directories = _directory_facts(
+        tuple(Path(item.path) for item in (topology.git, topology.remote_helper,
+                                           topology.interpreter, topology.askpass, *keys)),
+        stop=trusted_root,
+    )
+    facilities = _facility_facts()
+    required = {
+        "proc_cmdline",
+        "proc_exe",
+        "proc_stat",
+        "scm_credentials",
+        "scm_rights",
+        "so_passcred",
+    }
+    inspector = authority_inspector or DefaultWorkerAuthorityInspector()
+    protected = tuple(
+        item.path for item in (topology.askpass, *keys)
+    ) + tuple(item.path for item in directories)
+    observations = tuple(
+        inspector.observe(posture, protected)
+        for posture in sorted(
+            worker_postures,
+            key=lambda item: (
+                item.profile_id,
+                item.project_id,
+                item.harness_id,
+                item.lifecycle,
+                item.workspace_variant,
+                item.executable_digest,
+            ),
+        )
+    )
+    blockers: set[str] = set()
+    if set(facilities) != required:
+        blockers.add("worker_confinement_unverifiable")
+    if not observations:
+        blockers.add("worker_confinement_unverifiable")
+    for observation in observations:
+        if (
+            observation.same_uid
+            or observation.bypass_capable
+            or observation.protected_paths_writable
+        ):
+            blockers.add("askpass_worker_writable")
+        if not observation.policy_verified:
+            blockers.add("worker_confinement_unverifiable")
+        if not observation.control_plane_isolated:
+            blockers.add("worker_control_plane_unconfined")
+    facts = InstalledTransportFacts(
+        git=topology.git,
+        exec_path=str(exec_path.resolve(strict=True)),
+        remote_helper_link=topology.remote_helper_link,
+        remote_helper=topology.remote_helper,
+        interpreter=topology.interpreter,
+        askpass=topology.askpass,
+        directories=directories,
+        private_keys=tuple(keys),
+        facilities=facilities,
+        worker_authority=observations,
+    )
+    return TransportInspectionResult(facts=facts, blockers=tuple(sorted(blockers)))
