load("@rules_python//python:defs.bzl", "py_library")
load("@pypi//:requirements.bzl", "requirement")
load("//tools/bazel:generator_inputs.bzl", "GENERATOR_INPUTS")

# Data for the generator actions, not a catch-all application library. The
# checked inventory follows the spec/projection imports and scanned resources.
filegroup(
    name = "generator_sources",
    # Discovery must see additions as well as edits to the checked closure.
    # The inventory builder scans source module names, test ASTs and resource
    # directories; declaring these data inputs also makes stale inventory fail
    # inside Bazel, where undeclared checkout files are deliberately invisible.
    srcs = sorted({("//packages/aq-ts-client:package.json" if path == "packages/aq-ts-client/package.json" else path): True for path in GENERATOR_INPUTS + glob([
        "src/**/*.py",
        "scripts/*.py",
        "tests/**/*.py",
        "tests/selection_*.yaml",
        "tests/fixtures/generated_sources/**",
        "tests/fixtures/contracts/command_audit_modules/**",
        "src/profiles/defaults/**",
        "src/prompts/**",
        "src/sessions/default_harnesses/**",
        "docs/reference/playbook-commands/*.md",
    ], exclude = ["**/__pycache__/**", "**/.ruff_cache/**", "**/*.pyc"])}.keys()),
    visibility = ["//tools/bazel:__pkg__"],
)

exports_files([
    "package-lock.json",
    "scripts/regenerate-ts-client.sh",
], visibility = ["//tools/bazel:__pkg__"])

# Bootstrap source dependency for H1; never installs the generated client.
py_library(
    name = "generated_client_smoke",
    srcs = [
        "packages/aq-client/agent_queue_api_client/__init__.py",
        "packages/aq-client/agent_queue_api_client/client.py",
        "packages/aq-client/agent_queue_api_client/types.py",
    ],
    imports = ["packages/aq-client"],
    deps = [requirement("attrs"), requirement("httpx")],
    visibility = ["//tools/bazel/smoke:__pkg__"],
)

filegroup(
    name = "dashboard_inputs",
    srcs = [
        "package.json", "package-lock.json", "//packages/aq-ts-client:package.json",
        "//tools/bazel:pnpm-lock.yaml",
    ] + glob(["tests/fixtures/contracts/**/*.json"]),
    visibility = ["//visibility:public"],
)
