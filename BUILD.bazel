# Data for the generator actions, not a catch-all application library. The
# checked inventory follows the spec/projection imports and scanned resources.
filegroup(
    name = "generator_sources",
    # Discovery must see additions as well as edits to the checked closure.
    # The inventory builder scans source module names, test ASTs and resource
    # directories; declaring these data inputs also makes stale inventory fail
    # inside Bazel, where undeclared checkout files are deliberately invisible.
    srcs = sorted({path: True for path in [
        path
        for path in GENERATOR_INPUTS
        if not path.startswith(("src/", "tests/", "packages/aq-ts-client/"))
    ] + [
        "//tools/bazel:python_generator_inputs",
        "//packages/aq-ts-client:package.json",
    ] + glob([
        "scripts/*.py",
        "docs/reference/playbook-commands/*.md",
    ], exclude = ["**/__pycache__/**", "**/.ruff_cache/**", "**/*.pyc"])}.keys()),
    visibility = ["//tools/bazel:__pkg__"],
)

